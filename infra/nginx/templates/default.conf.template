# Rendered at container start by the nginx image entrypoint (envsubst).
# Only variables matching NGINX_ENVSUBST_FILTER (^VITADELTA_) are substituted;
# every other dollar sign below is an nginx variable.

# HSTS only when TLS is terminated in front of or at this nginx.
map "${VITADELTA_TLS}" $vitadelta_hsts {
    "true"  "max-age=63072000; includeSubDomains";
    default "";
}

# Client-supplied request ids are forwarded only when they match the API pattern;
# otherwise the header is dropped and the API generates its own id.
map $http_x_request_id $vitadelta_request_id {
    "~^[A-Za-z0-9-]{1,64}$" $http_x_request_id;
    default "";
}

# The web policy applies to every response. When the API already sent a policy
# (its own, stricter "default-src 'none'" for JSON), that one is kept instead of
# emitting two policies.
map $upstream_http_content_security_policy $vitadelta_csp {
    ""      "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'";
    default $upstream_http_content_security_policy;
}

map $upstream_http_referrer_policy $vitadelta_api_referrer_policy {
    ""      "strict-origin-when-cross-origin";
    default $upstream_http_referrer_policy;
}

# HTML documents are always revalidated so a new build is picked up immediately.
map $sent_http_content_type $vitadelta_cache_control {
    "~^text/html" "no-cache";
    default       "";
}

server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # The admin import accepts up to 20 MB; the API enforces that limit with problem+json.
    client_max_body_size 25m;

    location / {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cache-Control $vitadelta_cache_control always;
        # Unknown application routes fall back to the single-page app; index.html is
        # served from this location (not via an internal redirect) so the headers above apply.
        try_files $uri /index.html =404;
    }

    # Static files of the build (hashed bundles and chunks, styles, source maps, media,
    # icons) and the translation files: a missing file is a 404, never the app document,
    # so a stale chunk or an unknown translation fails visibly instead of as HTML.
    # Translation files keep their names across builds, so they are always revalidated.
    location ^~ /i18n/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    location ^~ /media/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cache-Control $vitadelta_cache_control always;
        try_files $uri =404;

        # Fonts and images referenced by the styles, named <name>-<hash>.<ext> by the build.
        # A nested location does not inherit add_header, so every header is repeated.
        location ~ "^/media/[^/]+-[A-Za-z0-9_-]{8}\.[A-Za-z0-9]+$" {
            include /etc/nginx/snippets/security-headers.conf;
            add_header Referrer-Policy "strict-origin-when-cross-origin" always;
            add_header Cache-Control "public, max-age=31536000, immutable";
            try_files $uri =404;
        }
    }

    # Fingerprinted bundles and chunks of the build (main-<hash>.js, chunk-<hash>.js,
    # styles-<hash>.css, ...): a changed file always gets a new name, so the old URL can be
    # cached for a year without revalidation. Cache-Control is sent without "always", so a
    # missing file (404) is never cached as immutable. Listed before the generic static
    # pattern below, which would match first otherwise.
    location ~ "^/(?:chunk|main|polyfills|styles|worker)-[A-Za-z0-9_-]{8}\.(?:js|mjs|css)$" {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    location ~* \.(?:js|mjs|css|map|json|ico|png|jpe?g|gif|svg|webp|avif|woff2?|ttf|otf|txt|xml|webmanifest)$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Cache-Control $vitadelta_cache_control always;
        try_files $uri =404;
    }

    # E-mail verification and password reset pages: tokens live in the URL fragment,
    # and these pages never leak the referrer.
    location ~ ^/auth/(verify|reset)/?$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Referrer-Policy "no-referrer" always;
        add_header Cache-Control "no-store" always;
        try_files /index.html =404;
    }

    # Actuator is internal only and is never reachable through the public origin.
    location ^~ /actuator {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        return 404;
    }

    # ^~ keeps API paths away from the static-file pattern above (an API path is
    # always proxied, whatever it ends with).
    location ^~ /api/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Referrer-Policy $vitadelta_api_referrer_policy always;

        # Replace upstream copies so each header appears exactly once.
        proxy_hide_header Content-Security-Policy;
        proxy_hide_header Referrer-Policy;
        proxy_hide_header X-Content-Type-Options;
        proxy_hide_header X-Frame-Options;
        proxy_hide_header Permissions-Policy;
        proxy_hide_header Strict-Transport-Security;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        # Overwrite, never append: the API trusts only the entry added by this proxy.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-Id $vitadelta_request_id;
        # Client-supplied forwarding headers are dropped.
        proxy_set_header Forwarded "";
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header X-Forwarded-Port "";
        proxy_set_header X-Forwarded-Prefix "";
        proxy_set_header X-Real-IP "";

        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_pass http://api:8080;
    }
}
