# Vitadelta configuration. Copy to .env (scripts/dev-up.sh does this for local
# development and fills in development values and fresh random secrets).
# Never commit .env. No value in this file is a default; every line is empty on purpose.

# JDBC URL of the PostgreSQL database (compose: database "vitadelta" on host "postgres").
VITADELTA_DB_URL=
# Database user; the compose postgres container is initialised with it.
VITADELTA_DB_USERNAME=
# Database password; the compose postgres container is initialised with it.
VITADELTA_DB_PASSWORD=
# HS256 signing secret for access tokens, at least 32 bytes; the API refuses to start without it.
VITADELTA_JWT_SECRET=
# Previous JWT signing secret, set only during a secret rotation so tokens it signed stay valid.
VITADELTA_JWT_SECRET_PREVIOUS=
# Secret for the signed anonymous cookie and refresh-token grace encryption; required.
VITADELTA_COOKIE_SECRET=
# Comma-separated origins allowed by CORS and the auth Origin check (e.g. the public web origin).
VITADELTA_WEB_ORIGINS=
# Public base URL of the web app, used in e-mail links; required; must be https outside the dev profile.
VITADELTA_WEB_BASE_URL=
# true to read X-Forwarded-For from trusted proxies; infra/docker-compose.yml sets it to true for the api.
VITADELTA_TRUST_PROXY=
# Comma-separated CIDR list of trusted proxy peers; infra/docker-compose.yml sets it to the nginx network.
VITADELTA_TRUSTED_PROXIES=
# Days after which never-logged-in unverified accounts are deleted (API default 30).
VITADELTA_UNVERIFIED_ACCOUNT_TTL_DAYS=
# true runs the schedulers (outbox, FX refresh, expiry, housekeeping); false disables all of them.
VITADELTA_JOBS_ENABLED=
# age public key (age1...) to which scripts/backup.sh encrypts database backups. Only the public
# key belongs here; the matching private key is kept off the backup host (docs/runbook.md).
VITADELTA_BACKUP_RECIPIENT=
# Controller contact shown on the privacy notice (GET /api/v1/legal); required outside the dev
# profile (the API refuses to start without it). scripts/dev-up.sh fills a local value.
VITADELTA_PRIVACY_CONTACT=
# Base URL of the scoring service as seen from the API (compose: the "scoring" service on port 8000);
# required, the API refuses to start without it.
VITADELTA_SCORING_BASE_URL=
# SMTP host for outgoing e-mail (compose: the "mailpit" service).
VITADELTA_SMTP_HOST=
# SMTP port (Mailpit: 1025).
VITADELTA_SMTP_PORT=
# SMTP user name; empty when the server needs no authentication.
VITADELTA_SMTP_USERNAME=
# SMTP password; empty when the server needs no authentication.
VITADELTA_SMTP_PASSWORD=
# true to require STARTTLS on the SMTP connection.
VITADELTA_SMTP_STARTTLS=
# Sender address of every e-mail the system sends; required.
VITADELTA_MAIL_FROM=
# Base URL of the FX rates provider. Leave empty to use the default, https://api.frankfurter.dev/v2
# (Frankfurter, ECB reference rates, refreshed every six hours). http or https only.
VITADELTA_FX_BASE_URL=
# Comma-separated ISO 4217 codes offered as display currencies in addition to country currencies.
# Each code must be one the provider publishes (ECB reference currencies); a code it does not publish
# gets no rate, so conversions to it stay unavailable and every refresh logs a warning.
VITADELTA_FX_EXTRA_CURRENCIES=
# Number of recommendation queries an anonymous visitor may run.
VITADELTA_ANON_QUERY_LIMIT=
# Number of result rows shown unlocked to anonymous visitors.
VITADELTA_ANON_VISIBLE_RESULTS=
# E-mail of the administrator account created on first start; leave empty to create none.
# For local development, scripts/dev-up.sh --bootstrap-admin fills both bootstrap values.
VITADELTA_BOOTSTRAP_ADMIN_EMAIL=
# Password of the bootstrap administrator account; leave empty to create none.
VITADELTA_BOOTSTRAP_ADMIN_PASSWORD=
# true when TLS is terminated at or in front of nginx; enables the HSTS header. Must stay false for plain-HTTP development.
VITADELTA_TLS=
