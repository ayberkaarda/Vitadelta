{
  "name": "web",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.23.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "eslint . && prettier --check . && tsc -p e2e/tsconfig.json && tsc -p e2e/adversarial/tsconfig.json && npm run i18n:check",
    "format": "prettier --write .",
    "i18n:check": "node scripts/check-i18n.mjs",
    "api:types": "npm ci --prefix tools/openapi --no-audit --no-fund && node tools/openapi/generate.mjs",
    "api:check": "npm ci --prefix tools/openapi --no-audit --no-fund && node tools/openapi/generate.mjs --check",
    "e2e": "playwright test --project=e2e",
    "e2e:adversarial": "playwright test --project=adversarial --retries=0",
    "e2e:install": "playwright install --only-shell chromium"
  },
  "dependencies": {
    "@angular/common": "22.3.0",
    "@angular/compiler": "22.3.0",
    "@angular/core": "22.3.0",
    "@angular/forms": "22.3.0",
    "@angular/platform-browser": "22.3.0",
    "@angular/router": "22.3.0",
    "@jsverse/transloco": "8.4.0",
    "rxjs": "7.8.2",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.3.0",
    "@angular/compiler-cli": "22.3.0",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.1.1",
    "angular-eslint": "22.8.0",
    "eslint": "10.15.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.74.0",
    "vitest": "5.1.1"
  }
}
